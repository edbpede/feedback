{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>engels74/automation:default#v1.0.0"],
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
      "description": "Astro and Svelte require the JavaScript TypeScript compiler API."
    },
    {
      "matchPackageNames": ["pdfjs-dist"],
      "groupName": "PDF parser and vendored worker",
      "automerge": false,
      "description": "Copy the matching installed PDF worker into public/; CI verifies byte parity."
    }
  ]
}
